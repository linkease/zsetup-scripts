param(
    [Parameter(ValueFromRemainingArguments=$true)]
    [string[]]$InstallerArguments
)
$ErrorActionPreference = 'Stop'
$AppId = '@APP_ID@'
$ConfigPrimaryUrls = @(@CONFIG_PRIMARY_URLS@)
$ConfigFallbackUrl = '@CONFIG_FALLBACK_URL@'
if ($AppId -eq 'ddnsto') {
    [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
    $OutputEncoding = [Console]::OutputEncoding
    $ProgressPreference = 'SilentlyContinue'
}

@BOOTSTRAP@

$active = Get-ZsetupBootstrap
$work = if ($env:ZSETUP_ROOT) { $env:ZSETUP_ROOT } else { Join-Path ([IO.Path]::GetTempPath()) 'zsetup' }
$configDirectory = Join-Path $work 'zsetup-scripts'
$config = Join-Path $configDirectory 'config-windows.json'
$candidate = $config + '.candidate-' + [Guid]::NewGuid().ToString('N')
New-Item -ItemType Directory -Path $configDirectory -Force -ErrorAction Stop | Out-Null
try {
    $downloadArguments = @('download', '--quiet', '-o', $candidate, '--max-bytes', '131072')
    $downloadArguments += $ConfigPrimaryUrls
    $downloadArguments += @('--fallback-url', $ConfigFallbackUrl)
    & $active @downloadArguments
    if ($LASTEXITCODE -ne 0) { throw "zsetup config download failed with exit code $LASTEXITCODE" }
    Move-Item -LiteralPath $candidate -Destination $config -Force -ErrorAction Stop
} finally {
    Remove-Item -LiteralPath $candidate -Force -ErrorAction SilentlyContinue
}
$env:ZSETUP_CONFIG = $config
if ($AppId -eq 'ddnsto') {
    $index = Join-Path $configDirectory 'ddnsto-index-windows.json'
    $candidate = $index + '.candidate-' + [Guid]::NewGuid().ToString('N')
    try {
        $arguments = @('download', '--quiet', '-o', $candidate, '--max-bytes', '131072')
        $arguments += @($ConfigPrimaryUrls | ForEach-Object { $_ -replace '/config-windows.json$', '/ddnsto-index-windows.json' })
        $arguments += @('--fallback-url', ($ConfigFallbackUrl -replace '/config-windows.json$', '/ddnsto-index-windows.json'))
        & $active @arguments
        if ($LASTEXITCODE -ne 0) { throw "DDNSTO native index download failed: $LASTEXITCODE" }
        Move-Item -LiteralPath $candidate -Destination $index -Force -ErrorAction Stop
    } finally {
        Remove-Item -LiteralPath $candidate -Force -ErrorAction SilentlyContinue
    }
    $env:ZSETUP_SOURCE_BASES = $script:BootstrapPrimaryBases -join ' '
    $env:ZSETUP_SOURCE_FALLBACK = $script:BootstrapFallbackBase
    & $active install --index $index $AppId --foreground -- @InstallerArguments
    exit $LASTEXITCODE
}
& $active install $AppId --foreground -- @InstallerArguments
exit $LASTEXITCODE
