#!/bin/sh
# The published coordinator compares index min_version with its legacy 0.1.0
# ABI. Enforce the application's real runtime floor before any business code.
ddnsto_require_native_version() (
    value=$("${ZSETUP_BIN:?}" --version) || exit 2
    case "$value" in 'zsetup '*) value=${value#zsetup } ;; *) exit 2 ;; esac
    old_ifs=$IFS; IFS=.; set -- $value; IFS=$old_ifs
    [ "$#" = 3 ] || exit 2
    for part in "$@"; do
        case "$part" in ''|*[!0-9]*|0[0-9]*) exit 2 ;; esac
        [ "${#part}" -le 6 ] || exit 2
    done
    [ "$1" -gt @@MAJOR@@ ] || {
        [ "$1" = @@MAJOR@@ ] && { [ "$2" -gt @@MINOR@@ ] || {
            [ "$2" = @@MINOR@@ ] && [ "$3" -ge @@PATCH@@ ];
        }; }
    }
)
if [ "${ZSETUP_INSTALLER_MODE:-0}" = 1 ]; then
    ddnsto_require_native_version || {
        printf '%s\n' 'DDNSTO: zsetup >=@@MINIMUM@@ required; no client changes; code=2' >&2
        exit 2
    }
fi
# DDNSTO native floor end
