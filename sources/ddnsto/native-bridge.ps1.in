param([Parameter(ValueFromRemainingArguments=$true)][string[]]$InstallerArguments)
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
try {
    if ($env:ZSETUP_INSTALLER_MODE -eq '1') {
        $reported = & $env:ZSETUP_BIN --version
        if ($LASTEXITCODE -ne 0 -or $reported -cnotmatch '^zsetup ([0-9]+\.[0-9]+\.[0-9]+)$' -or
            [Version]$Matches[1] -lt [Version]'@@MINIMUM@@') {
            throw 'DDNSTO: compatible zsetup >=@@MINIMUM@@ required; no client changes'
        }
    }
    # Native invokes PowerShell with an argument array. Array splatting into a
    # named-parameter script binds positionally; parse the public grammar first.
    $DDNSTOParameters = @{}
    $valueNames = @('Token', 'TokenFile', 'Version', 'InstallDir', 'Platform', 'Method', 'Action', 'Environment')
    $switchNames = @('Plan', 'SwitchEnvironment')
    for ($i = 0; $i -lt $InstallerArguments.Count; $i++) {
        $item = $InstallerArguments[$i]
        if ($item -notmatch '^-[A-Za-z]+$') { throw 'DDNSTO: invalid installer option; no client changes' }
        $name = $item.Substring(1)
        if ($DDNSTOParameters.ContainsKey($name)) { throw 'DDNSTO: duplicate installer option; no client changes' }
        if ($switchNames -contains $name) { $DDNSTOParameters[$name] = $true }
        elseif ($valueNames -contains $name) {
            $i++
            if ($i -ge $InstallerArguments.Count) { throw 'DDNSTO: missing installer value; no client changes' }
            $DDNSTOParameters[$name] = $InstallerArguments[$i]
        } else { throw 'DDNSTO: unsupported installer option; no client changes' }
    }
} catch {
    [Console]::Error.WriteLine($_.Exception.Message)
    exit 2
}
& {
@@PAYLOAD@@
} @DDNSTOParameters
