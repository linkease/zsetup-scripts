{
  "schema_version": 1,
  "product": "ddnsto",
  "status": "engineering-candidate",
  "candidate": true,
  "production_ready": false,
  "cloud_online_verified": false,
  "default_workflow": {
    "action": "ensure",
    "interactive_choices": false,
    "required_input": "account-token",
    "success": "local-service-stable-running-only",
    "cloud_online_check": false,
    "same_or_newer_version": "enable-and-start-without-downgrade",
    "different_or_unknown_account": "fail-closed",
    "platform_requirements": {
      "linux": ["systemd", "protected-installation-receipts", "jq-for-existing-account-check"],
      "openwrt": ["opkg-or-apk", "uci", "ubus", "jsonfilter"],
      "macos": ["logged-in-user-launchd-domain"],
      "synology": ["DSM-7", "administrator-sudo", "synopkg", "jq-1.5-or-newer", "protected-package-config", "ARM64-only-DS220j-compatibility-canary"],
      "windows": ["administrator", "windows-x64"]
    },
    "unsupported_platforms": ["qnap", "unraid"],
    "unsupported_methods": ["docker"],
    "native_device_acceptance": "pending"
  },
  "scope": "Declarative direct-entry capabilities; no core source or global catalog required. Executor availability is subject to local preflight, not production acceptance.",
  "unsupported_platforms": ["qnap", "unraid"],
  "unsupported_methods": [],
  "method_selection": "Only explicitly declared platform, architecture and method combinations are available; absence from unsupported lists does not imply support.",
  "platforms": {
    "linux": {
      "architectures": ["x86_64", "aarch64"],
      "method": "native",
      "actions": ["install", "update", "status", "start", "stop", "restart", "repair", "configure", "uninstall"],
      "action_requirements": {"configure": ["jq"]},
      "lifecycle_requirements": {
        "actions": ["start", "stop", "restart", "repair", "configure", "uninstall"],
        "executors": ["systemd"]
      },
      "limitations": {
        "openrc": {
          "supported_actions": ["install", "update", "status"],
          "unsupported_actions": ["start", "stop", "restart", "repair", "configure", "uninstall"]
        }
      },
      "executors": ["systemd", "openrc"],
      "requirements": ["root-or-sudo", "initialized-service-manager"],
      "client_versions": {"standard": "@@linux.client_version@@"},
      "min_zsetup": "0.5.0",
      "zsetup_channel": "linux-stable",
      "native_canary_verified": false
    },
    "openwrt": {
      "architectures": ["x86_64", "aarch64", "armv7", "mipsel"],
      "product_arch_aliases": {"armv7": "arm"},
      "method": "native",
      "actions": ["install", "update", "status", "start", "stop", "restart", "repair", "configure", "uninstall"],
      "executors": ["opkg", "apk"],
      "requirements": ["root", "compatible-package-abi", "little-endian-mips-only"],
      "client_versions": {"standard": "@@openwrt.client_version@@", "lite": "@@openwrt.client_version@@"},
      "min_zsetup": "0.5.0",
      "zsetup_channel": "linux-stable",
      "native_canary_verified": false
    },
    "macos": {
      "architectures": ["x86_64", "aarch64"],
      "method": "native",
      "actions": ["install", "update", "status", "start", "stop", "restart", "repair", "configure", "uninstall"],
      "executors": ["launchd-user"],
      "requirements": ["logged-in-user-launchd-domain"],
      "client_versions": {"standard": "@@macos.client_version@@"},
      "min_zsetup": "0.5.0",
      "zsetup_channel": "macos-stable",
      "native_canary_verified": false
    },
    "windows": {
      "architectures": ["x86_64"],
      "method": "native",
      "actions": ["install", "update", "status", "start", "stop", "restart", "repair", "configure", "uninstall"],
      "executors": ["scheduled-task-system"],
      "requirements": ["administrator", "windows-x64", "i686-bootstrap-execution"],
      "client_versions": {"standard": "@@windows.client_version@@"},
      "min_zsetup": "0.5.0",
      "zsetup_channel": "windows-stable",
      "native_canary_verified": false
    },
    "synology": {
      "default_action": "ensure",
      "automatic_dsm_majors": [7],
      "automatic_installation_acceptance": "DS220j-DSM7.1-fresh-install-upgrade-and-start-verified; other-models-unverified",
      "fresh_install_requirements": ["synowebapi", "default-install-volume", "no-existing-package-or-retained-config", "SHA256-verified-third-party-SPK"],
      "arm64_compatibility_models": ["DS220j"],
      "architectures": ["x86_64", "armv7", "aarch64"],
      "architecture_constraints": {"aarch64": "DSM7 DS220j only; ARM32 SPK compatibility"},
      "dsm_minimum_builds": {"6": 5940, "7": 41890},
      "method": "download",
      "executors": ["dsm7-package-api-fresh-install", "synopkg-existing-package", "spk-download-manual-handoff"],
      "client_versions": {"spk": "@@synology.package_version@@"},
      "actions": ["ensure", "download", "install"],
      "action_results": {
        "ensure": {"exit_code": 0, "local_service_started": true, "cloud_online_checked": false},
        "download": {"exit_code": 0, "installation_performed": false, "manual_handoff_required": true},
        "install": {"exit_code": 20, "installation_performed": false, "manual_handoff_required": true}
      },
      "handoff": "Manually install the verified SPK through DSM Package Center; download completion is not installation success.",
      "artifacts": {
        "synology/@@synology.package_version@@/ddnsto_arm-dsm6.spk": "@@synology.arm_6_sha256@@",
        "synology/@@synology.package_version@@/ddnsto_arm-dsm7.spk": "@@synology.arm_7_sha256@@",
        "synology/@@synology.package_version@@/ddnsto_x86-dsm6.spk": "@@synology.x86_6_sha256@@",
        "synology/@@synology.package_version@@/ddnsto_x86-dsm7.spk": "@@synology.x86_7_sha256@@"
      },
      "candidate": true,
      "native_canary_verified": false
    }
  },
  "method_capabilities": {
    "docker": {
      "platforms": ["linux"],
      "architectures": ["x86_64"],
      "engine_platform": "linux/amd64",
      "engine_requirements": {"endpoint": "local-unix-socket", "rootless": false, "desktop": false},
      "required_explicit_inputs": ["network", "device-name"],
      "networks": ["bridge", "host"],
      "token_policy": "validated-safe-value-private-env-file",
      "actions": ["install", "update", "status", "start", "stop", "restart", "uninstall", "repair"],
      "unsupported_actions": ["configure"],
      "client_version": "4.2.6",
      "image": "linkease/ddnsto@sha256:f70d2afbb0da6b21ff8865a4f3d9869775360bfbec1fff03474e5478a702ad30",
      "update_policy": "same-pin-no-op-recreation-blocked",
      "repair_policy": "start-existing-owned-container-only",
      "reinstall_policy": "blocked-identity-unverified",
      "full_lifecycle_supported": false,
      "write_privilege": "root-shell-required",
      "interactive_inputs": "fresh-no-conflict-only-visible-token-name-network",
      "identity_persistence_verified": false,
      "candidate": true,
      "native_canary_verified": false
    }
  },
  "zsetup_policy": {
    "selection": "latest-platform-stable",
    "minimum_version": "0.5.0",
    "exact_version_pins": false,
    "channels": {
      "linux-stable": "zsetup/stable",
      "macos-stable": "zsetup/stable-macos",
      "windows-stable": "zsetup/stable-windows"
    }
  }
}
