# Generated from templates/install.ps1.in and platform-releases.json; edit those sources, then run scripts/build-entrypoints.py.
# Engineering candidate. Automatic zsetup bootstrap; native canary pending.
param([string]$Token = '', [string]$TokenFile = '', [string]$Version = '@@windows.client_version@@',
      [string]$InstallDir = "$env:ProgramData\DDNSTO", [string]$Platform = 'auto',
      [string]$Method = 'auto', [switch]$Plan, [string]$Action = 'ensure',
      [ValidateSet('production', 'test')][string]$Environment = 'production', [switch]$SwitchEnvironment)
$ErrorActionPreference = 'Stop'
$script:DDNSTOTaskName = 'DDNSTO'
@@SHARED_BOOTSTRAP@@

function Get-DDNSTOHostArchitecture {
    if ([Environment]::OSVersion.Platform -ne [PlatformID]::Win32NT) { throw 'DDNSTO: Windows is required' }
    if ($env:PROCESSOR_ARCHITEW6432) { return $env:PROCESSOR_ARCHITEW6432 }
    return $env:PROCESSOR_ARCHITECTURE
}

function Stop-DDNSTOError($Code, $Reason, $State, $Next) {
    $error = New-Object InvalidOperationException("DDNSTO：$Reason；状态：$State；下一步：$Next；错误码：$Code")
    $error.Data['DDNSTOCode'] = [int]$Code
    throw $error
}

function Get-DDNSTODiagnosticBase {
    if ([Environment]::OSVersion.Platform -ne [PlatformID]::Win32NT) { throw 'Windows required' }
    # Known-folder API, independent of Token, InstallDir and caller-supplied paths.
    return [Environment]::GetFolderPath([Environment+SpecialFolder]::LocalApplicationData)
}

function Initialize-DDNSTODiagnosticNative {
    if ('DDNSTO.PrivateDiagnosticDirectory' -as [type]) { return }
    # CreateDirectoryW fails on collisions and installs the protected DACL at
    # creation. Never create a public directory and tighten its ACL afterwards.
    Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;
namespace DDNSTO {
    public static class PrivateDiagnosticDirectory {
        [StructLayout(LayoutKind.Sequential)]
        struct SecurityAttributes {
            public int Length;
            public IntPtr Descriptor;
            public int InheritHandle;
        }
        [DllImport("advapi32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
        static extern bool ConvertStringSecurityDescriptorToSecurityDescriptorW(string text, uint revision, out IntPtr descriptor, out uint size);
        [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
        static extern bool CreateDirectoryW(string path, ref SecurityAttributes attributes);
        [DllImport("kernel32.dll")]
        static extern IntPtr LocalFree(IntPtr pointer);
        public static void Create(string path, string sid) {
            IntPtr descriptor;
            uint size;
            string sddl = "D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;" + sid + ")";
            if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, 1, out descriptor, out size))
                throw new Win32Exception(Marshal.GetLastWin32Error());
            try {
                var attributes = new SecurityAttributes();
                attributes.Length = Marshal.SizeOf(typeof(SecurityAttributes));
                attributes.Descriptor = descriptor;
                if (!CreateDirectoryW(path, ref attributes))
                    throw new Win32Exception(Marshal.GetLastWin32Error());
            } finally { LocalFree(descriptor); }
        }
    }
}
'@ -ErrorAction Stop
}

function New-DDNSTOPrivateDiagnosticDirectory($Path) {
    Initialize-DDNSTODiagnosticNative
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    try { [DDNSTO.PrivateDiagnosticDirectory]::Create($Path, $identity.User.Value) }
    finally { $identity.Dispose() }
}

function New-DDNSTODiagnostic {
    $stream = $null
    try {
        $base = Get-DDNSTODiagnosticBase
        if (-not [IO.Path]::IsPathRooted($base)) { throw 'absolute diagnostic base required' }
        $ancestor = [IO.Path]::GetFullPath($base)
        while ($ancestor) {
            $item = Get-Item -LiteralPath $ancestor -Force -ErrorAction Stop
            if (-not $item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'unsafe diagnostic base' }
            $ancestor = [IO.Path]::GetDirectoryName($ancestor)
        }
        $directory = Join-Path $base ('DDNSTO-install-' + [guid]::NewGuid().ToString('N'))
        New-DDNSTOPrivateDiagnosticDirectory $directory
        Assert-DDNSTOSafePaths $directory
        $path = Join-Path $directory 'events.jsonl'
        $stream = [IO.File]::Open($path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
        return [pscustomobject]@{ Stream=$stream; Path=$path; Healthy=$true; Count=0 }
    } catch {
        if ($stream) { try { $stream.Dispose() } catch { } }
        # Do not delete or reuse a path on failure; it may belong to another run.
        return $null
    }
}

function Write-DDNSTODiagnosticEvent($Event, [int]$Code = 0) {
    $log = $script:DDNSTODiagnostic
    if (-not $log -or -not $log.Healthy) { return }
    # Strict vocabulary and bounded records: no exceptions, arguments, paths,
    # configuration, process output or credentials are accepted as event data.
    if ($Event -cnotin @('started','preflight','download','version','stability','rollback','succeeded','failed') -or
        $Code -notin @(0,1,2,3,4,5,6) -or $log.Count -ge 32) { return }
    try {
        $record = [ordered]@{ time=[DateTime]::UtcNow.ToString('o'); event=$Event; code=$Code } | ConvertTo-Json -Compress
        $bytes = [Text.Encoding]::UTF8.GetBytes($record + "`n")
        $log.Stream.Write($bytes, 0, $bytes.Length)
        $log.Stream.Flush()
        $log.Count++
    } catch { $log.Healthy = $false }
}

function Get-DDNSTODiagnosticPointer {
    $log = $script:DDNSTODiagnostic
    if (-not $log) { return '诊断日志不可用：未能安全创建私有日志，请保留错误码' }
    if (-not $log.Healthy) { return "诊断日志：$($log.Path)（写入失败，记录可能不完整）" }
    return "诊断日志：$($log.Path)"
}

function Invoke-DDNSTOEntry {
    param([string]$Token = '', [string]$TokenFile = '', [string]$Version = '@@windows.client_version@@',
          [string]$InstallDir = "$env:ProgramData\DDNSTO", [string]$Platform = 'auto',
          [string]$Method = 'auto', [switch]$Plan, [string]$Action = 'ensure',
          [ValidateSet('production', 'test')][string]$Environment = 'production', [switch]$SwitchEnvironment)
    $previousLog = $script:DDNSTODiagnostic
    $script:DDNSTODiagnostic = $null
    try {
        # Preview remains read-only, including failure paths.
        if (-not $Plan) { $script:DDNSTODiagnostic = New-DDNSTODiagnostic }
        Write-DDNSTODiagnosticEvent 'started'
        Write-DDNSTODiagnosticEvent 'preflight'
        Invoke-DDNSTOEntryCore @PSBoundParameters
        Write-DDNSTODiagnosticEvent 'succeeded'
        if (-not $Plan -and $script:DDNSTODiagnostic) { Write-Host (Get-DDNSTODiagnosticPointer) }
    }
    catch {
        $code = 2
        $message = 'DDNSTO：参数、权限或安装归属检查失败；状态：未确认本地运行状态；下一步：检查参数和目录，使用管理员 PowerShell 重试；已有安装可用 -Action status 检查；错误码：2'
        if ($_.Exception.Data.Contains('DDNSTOCode')) { $code = [int]$_.Exception.Data['DDNSTOCode']; $message = $_.Exception.Message }
        Write-DDNSTODiagnosticEvent 'failed' $code
        $failure = New-Object InvalidOperationException($message + '；' + (Get-DDNSTODiagnosticPointer))
        $failure.Data['DDNSTOCode'] = $code
        throw $failure
    } finally {
        if ($script:DDNSTODiagnostic) { try { $script:DDNSTODiagnostic.Stream.Dispose() } catch { } }
        $script:DDNSTODiagnostic = $previousLog
    }
}

function Invoke-DDNSTOEntryCore {
    param([string]$Token = '', [string]$TokenFile = '', [string]$Version = '@@windows.client_version@@',
          [string]$InstallDir = "$env:ProgramData\DDNSTO", [string]$Platform = 'auto',
          [string]$Method = 'auto', [switch]$Plan, [string]$Action = 'ensure',
          [ValidateSet('production', 'test')][string]$Environment = 'production', [switch]$SwitchEnvironment)
    if ($Action -notin @('ensure', 'install', 'update', 'status', 'start', 'stop', 'restart', 'repair', 'uninstall', 'configure')) { throw 'DDNSTO: unknown action' }
    if ($Platform -notin @('auto', 'windows')) { throw 'DDNSTO: platform mismatch: this entry requires windows' }
    if ($Method -eq 'docker') { throw 'DDNSTO: Docker installer is not available for Windows' }
    if ($Method -notin @('auto', 'native')) { throw 'DDNSTO: unknown installation method' }
    if ($SwitchEnvironment -and $Action -notin @('ensure', 'update')) {
        Stop-DDNSTOError 2 'E_ENV_SWITCH_ACTION：仅 ensure/update 可以切换业务环境' '未修改安装' '使用原 Token 和 -Environment 配合 -SwitchEnvironment'
    }
    if ($Plan) {
        if ($Action -notin @('ensure', 'install')) { throw 'DDNSTO: -Plan requires ensure or install' }
        if ($Token -or $TokenFile) { throw 'DDNSTO: -Plan does not accept credentials' }
        if ($Version -ne '@@windows.client_version@@') { throw 'DDNSTO: no pinned artifact for requested version' }
        if ((Get-DDNSTOHostArchitecture) -ne 'AMD64') { throw 'DDNSTO: unsupported architecture; requires Windows x64' }
        # No admin check, download, token file read, directory or task creation.
        return @('facts_source=local-preflight', 'platform=windows', 'arch=x86_64',
            'client_version=@@windows.client_version@@', 'zsetup_channel=zsetup/stable-windows',
            'zsetup_min_version=0.5.0',
            'native_status=requires-admin-task-preflight', 'docker_installable=false',
            "business_environment=$Environment", 'installation_performed=false')
    }
    if ($Action -in @('start', 'restart', 'repair', 'configure')) {
        $null = Assert-DDNSTOBusinessEnvironment $InstallDir $Environment
        Assert-DDNSTOEnvironmentCapability (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe') $Environment
    }
    if ($Action -in @('uninstall', 'configure')) {
        return Invoke-DDNSTOLifecycle -InstallDir $InstallDir -Action $Action -Token $Token -TokenFile $TokenFile
    }
    if ($Action -in @('status', 'start', 'stop', 'restart', 'repair')) {
        if ($Token -or $TokenFile) { throw 'DDNSTO: service actions do not accept credentials' }
        if ($Action -eq 'repair') { return Invoke-DDNSTORepair -InstallDir $InstallDir }
        return Invoke-DDNSTOManageService -InstallDir $InstallDir -Action $Action
    }
    Invoke-DDNSTOInstall -Token $Token -TokenFile $TokenFile -Version $Version -InstallDir $InstallDir -Action $Action -Environment $Environment -SwitchEnvironment:$SwitchEnvironment
}

# Closed vocabulary, not arbitrary server URLs. These assignments override the
# encrypted boot server after loading it; Token and identity remain untouched.
function Get-DDNSTOBusinessAssignment([string]$Environment) {
    switch -CaseSensitive ($Environment) {
        'production' { return '{"serverDomain":"kooldns.cn","legacyControlAddr":"tunnel.kooldns.cn:4445"}' }
        'test' { return '{"serverDomain":"toany.net","legacyControlAddr":"tunnel.toany.net:4445","controlWssURLs":["wss://web.toany.net:9445/ws/control"],"publicWssURLs":["wss://web.toany.net:9445/__ws/public"]}' }
        default { throw 'DDNSTO: unknown business environment' }
    }
}

function Get-DDNSTORecordedEnvironment($Config) {
    $text = [IO.File]::ReadAllText($Config)
    $records = [regex]::Matches($text, '(?m)^# ddnsto-business-environment-v1=(production|test)\r?$')
    if ($records.Count -eq 1 -and [regex]::Matches($text, 'ddnsto-business-environment-v1').Count -eq 1) {
        return $records[0].Groups[1].Value
    }
    if ($text.Contains('ddnsto-business-environment-v1')) { throw 'DDNSTO: invalid business environment record' }
    return ''
}

function Get-DDNSTOEnvironmentAction($Binary, $Config, $Directory, $Environment) {
    $assignment = Get-DDNSTOBusinessAssignment $Environment
    # The task owns this literal command. No .ps1 file, execution-policy change,
    # user profile, machine-wide environment, or data interpreted as code.
    $command = "`$ErrorActionPreference='Stop'; `$env:DDNSTO_TEST_SERVER_ASSIGNMENT_JSON='" + $assignment + "'; & '" + $Binary.Replace("'", "''") + "' --config '" + $Config.Replace("'", "''") + "'; exit `$LASTEXITCODE"
    return [pscustomobject]@{
        Execute = [IO.Path]::Combine([Environment]::GetFolderPath([Environment+SpecialFolder]::System), 'WindowsPowerShell\v1.0\powershell.exe')
        Arguments = ('-NoLogo -NoProfile -NonInteractive -EncodedCommand ' + [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command)))
        WorkingDirectory = $Directory
    }
}

function Test-DDNSTOTaskAction($Task, $Expected) {
    return ($Task -and @($Task.Actions).Count -eq 1 -and
        $Task.Actions[0].Execute -ieq $Expected.Execute -and
        $Task.Actions[0].Arguments -ceq $Expected.Arguments -and
        $Task.Actions[0].WorkingDirectory -ieq $Expected.WorkingDirectory)
}

function Assert-DDNSTOBusinessEnvironment($InstallDir, $Environment, [switch]$SwitchEnvironment) {
    Assert-DDNSTOSafePaths $InstallDir
    $config = Join-Path $InstallDir 'ddnsto.yaml'
    if (-not (Test-Path -LiteralPath $config -PathType Leaf)) { return $Environment }
    $text = [IO.File]::ReadAllText($config)
    # Check explicit server/identity overrides without imposing a whole-YAML
    # grammar on legacy configurations. Token and task ownership are separate.
    foreach ($line in ($text -split '\r?\n')) {
        if ($line -match '^\s*(#.*)?$') { continue }
        if ($line -imatch '(?:^|[,{])\s*[''"]?(remoteAddr|serverAddr|serverAssignment|serverDomain|controlWssURLs|publicWssURLs|bootConfigPath)[''"]?\s*:') {
            Stop-DDNSTOError 2 'E_ENV_UNKNOWN：配置包含自定义服务端/身份路径' '原安装保留' '人工确认并迁移自定义配置'
        }
    }
    $current = Get-DDNSTORecordedEnvironment $config
    # A comment alone is not proof of the running task's environment. Require
    # byte-exact canonical task arguments whenever a task is present.
    if (Get-DDNSTOTask) { $null = Assert-DDNSTOManagedTask $InstallDir }
    if (-not $current) {
        # Legacy installations without a record use the production default.
        # Task ownership is still checked above, independently of this default.
        $current = 'production'
    }
    if ($current -cne $Environment -and -not $SwitchEnvironment) {
        Stop-DDNSTOError 2 "E_ENV_MISMATCH：已有业务环境为 $current，目标为 $Environment" '原安装保留' '确认后使用 ensure/update 与 -SwitchEnvironment；维护原环境请传入匹配的 -Environment'
    }
    return $current
}

function Set-DDNSTOBusinessEnvironment($Config, $Environment) {
    $null = Get-DDNSTOBusinessAssignment $Environment
    $text = [IO.File]::ReadAllText($Config)
    $record = '# ddnsto-business-environment-v1=' + $Environment
    if (Get-DDNSTORecordedEnvironment $Config) {
        $text = [regex]::Replace($text, '(?m)^# ddnsto-business-environment-v1=(production|test)(?=\r?$)', $record)
    } else { $text = $record + "`n" + $text }
    [IO.File]::WriteAllText($Config, $text, (New-Object Text.UTF8Encoding($false)))
}

function Assert-DDNSTOEnvironmentCapability($Binary, $Environment, [switch]$SwitchEnvironment) {
    if ($Environment -eq 'test' -or $SwitchEnvironment) {
        # Only the reviewed, pinned binary is certified for assignment. Version
        # strings alone do not prove a historic/custom build implements it.
        if ((Get-FileHash -LiteralPath $Binary -Algorithm SHA256).Hash -ine '@@windows.binary_sha256@@') {
            Stop-DDNSTOError 2 'E_ENV_CAPABILITY：客户端不在已审核的业务环境支持范围' '原安装保留' '使用推荐的 Windows CLI 安装包；不强制降级'
        }
    }
}

function Assert-DDNSTOSafePaths($InstallDir) {
    if (-not [IO.Path]::IsPathRooted($InstallDir)) { throw 'DDNSTO: installation path must be absolute' }
    # Check ancestors as well as children: a normal leaf below a junction is unsafe too.
    $ancestor = [IO.Path]::GetFullPath($InstallDir)
    while ($ancestor) {
        $item = Get-Item -LiteralPath $ancestor -Force -ErrorAction SilentlyContinue
        if ($item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'DDNSTO: reparse points are not supported' }
        $ancestor = [IO.Path]::GetDirectoryName($ancestor)
    }
    if (Test-Path -LiteralPath $InstallDir) {
        if (-not (Test-Path -LiteralPath $InstallDir -PathType Container)) { throw 'DDNSTO: installation directory required' }
        foreach ($item in @(Get-ChildItem -LiteralPath $InstallDir -Force -Recurse)) {
            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'DDNSTO: reparse points are not supported' }
        }
    }
}

function Get-DDNSTOManagedState($InstallDir) {
    Assert-DDNSTOSafePaths $InstallDir
    $marker = Join-Path $InstallDir '.installer-windows-v1'
    $config = Join-Path $InstallDir 'ddnsto.yaml'
    $binary = Join-Path $InstallDir 'ddnsto_cli.x86_64.exe'
    foreach ($path in @($marker, $config)) {
        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { throw 'DDNSTO: managed configuration and marker required' }
    }
    switch -CaseSensitive ([IO.File]::ReadAllText($marker)) {
        'ddnsto-windows-v1:recovery-required' { return 'recovery-required' }
        'ddnsto-windows-v1' {
            if (-not (Test-Path -LiteralPath $binary -PathType Leaf)) { throw 'DDNSTO: incomplete previous installation' }
            return 'installed'
        }
        'ddnsto-windows-v1:retained' {
            if ((Test-Path -LiteralPath $binary) -or (Get-DDNSTOTask)) { throw 'DDNSTO: inconsistent retained installation' }
            return 'retained'
        }
        default { throw 'DDNSTO: unknown installation marker' }
    }
}

# Uninstall preserves all data except the managed executable and task. Reinstall
# consumes that explicit retained state; configure changes only the top-level Token.
function Invoke-DDNSTOLifecycle {
    param([string]$InstallDir, [string]$Action, [string]$Token = '', [string]$TokenFile = '', [string]$Version = '@@windows.client_version@@')
    Assert-DDNSTOPlatform
    if ($Action -notin @('uninstall', 'reinstall', 'configure')) { throw 'DDNSTO: unknown lifecycle action' }
    if ($Action -eq 'uninstall' -and ($Token -or $TokenFile)) { throw 'DDNSTO: this action preserves credentials' }
    if ($Action -eq 'reinstall' -and $Version -ne '@@windows.client_version@@') { throw 'DDNSTO: no pinned artifact for requested version' }
    $state = Get-DDNSTOManagedState $InstallDir
    if ($state -eq 'recovery-required') { throw 'DDNSTO: manual recovery from retained backup required' }
    if ($Action -eq 'reinstall' -and $state -ne 'retained') { throw 'DDNSTO: retained installation required' }
    if ($Action -eq 'configure' -and $state -ne 'installed') { throw 'DDNSTO: installed service required for configure' }
    if ($state -eq 'installed') { $null = Assert-DDNSTOManagedTask $InstallDir -AllowMissingTask:($Action -eq 'uninstall') }
    if ($Action -eq 'configure') {
        # Explicit configure plus credentials is the confirmation contract.
        if ($TokenFile) {
            if ($Token) { throw 'DDNSTO: choose Token or TokenFile' }
            try { $Token = [IO.File]::ReadAllText($TokenFile) -replace '\r?\n$', '' }
            catch { throw 'DDNSTO: could not read Token file' }
        }
        if ([string]::IsNullOrWhiteSpace($Token) -or $Token -match '[\x00-\x1f\x7f]') { throw 'DDNSTO: configure requires a nonempty single-line Token or TokenFile' }
    }
    $lockPath = Join-Path $InstallDir '.install-lock'
    $lock = [IO.File]::Open($lockPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
    $work = Join-Path $InstallDir ('.lifecycle-' + [guid]::NewGuid().ToString('N'))
    $binary = Join-Path $InstallDir 'ddnsto_cli.x86_64.exe'
    $config = Join-Path $InstallDir 'ddnsto.yaml'
    $marker = Join-Path $InstallDir '.installer-windows-v1'
    $changed = $false; $keepBackup = $false; $oldTask = $null; $oldXml = ''; $wasRunning = $false
    try {
        if ((Get-DDNSTOManagedState $InstallDir) -ne $state) { throw 'DDNSTO: installation changed; retry' }
        if ($Action -eq 'reinstall') { Assert-DDNSTOSameToken $config $Token }
        if ($state -eq 'installed') {
            $oldTask = Assert-DDNSTOManagedTask $InstallDir -AllowMissingTask:($Action -eq 'uninstall')
        }
        if ($state -eq 'retained' -and $Action -eq 'uninstall') {
            return 'operation=none installation=retained local_service=not-installed configuration=retained identity=retained cloud_status=unverified'
        }
        New-Item -ItemType Directory -Path $work | Out-Null
        Copy-Item -LiteralPath $marker -Destination (Join-Path $work 'old-marker')
        Copy-Item -LiteralPath $config -Destination (Join-Path $work 'old.yaml')
        if ($state -eq 'installed') { Copy-Item -LiteralPath $binary -Destination (Join-Path $work 'old.exe') }
        if ($oldTask) {
            $oldXml = Export-DDNSTOTask
            if ([string]::IsNullOrWhiteSpace($oldXml)) { throw 'DDNSTO: could not export previous task' }
            [IO.File]::WriteAllText((Join-Path $work 'old-task.xml'), $oldXml)
            $wasRunning = $oldTask.State -eq 'Running'
        }
        if ($Action -eq 'reinstall') { $candidate = Receive-DDNSTOCandidate $work $Version }
        if ($Action -eq 'configure') {
            $text = [IO.File]::ReadAllText($config)
            # Only rewrite the installer's single-line quoted scalar, not arbitrary YAML.
            $pattern = "(?m)^userToken: '(?:[^'\r\n]|'')*'(?=\r?$)"
            if ([regex]::Matches($text, $pattern).Count -ne 1 -or
                [regex]::Matches($text, '(?m)^\s*userToken\s*:').Count -ne 1) {
                throw 'DDNSTO: configure requires exactly one installer-format single-line quoted userToken field'
            }
            $line = "userToken: '" + $Token.Replace("'", "''") + "'"
            $updated = [regex]::Replace($text, $pattern, [Text.RegularExpressions.MatchEvaluator]{ param($match) $line })
            [IO.File]::WriteAllText((Join-Path $work 'new.yaml'), $updated, (New-Object Text.UTF8Encoding($false)))
        }
        $changed = $true
        if ($oldTask) { Stop-DDNSTOTask }
        switch ($Action) {
            'uninstall' {
                Remove-DDNSTOTask
                if (Get-DDNSTOTask) { throw 'DDNSTO: task removal failed' }
                Remove-Item -LiteralPath $binary -Force
                [IO.File]::WriteAllText($marker, 'ddnsto-windows-v1:retained')
            }
            'reinstall' {
                Copy-Item -LiteralPath $candidate -Destination $binary
                Register-DDNSTOTask $binary $config $InstallDir
                Start-DDNSTOTask
                Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
                [IO.File]::WriteAllText($marker, 'ddnsto-windows-v1')
            }
            'configure' {
                Copy-Item -LiteralPath (Join-Path $work 'new.yaml') -Destination $config -Force
                # Re-register to enable a previously disabled task; XML is saved for rollback.
                Register-DDNSTOTask $binary $config $InstallDir
                Start-DDNSTOTask
                Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
            }
        }
        $changed = $false
    } catch {
        if ($changed) {
            try {
                if (Get-DDNSTOTask) { Stop-DDNSTOTask }
                if ($state -eq 'installed') {
                    Copy-Item -LiteralPath (Join-Path $work 'old.exe') -Destination $binary -Force
                    Copy-Item -LiteralPath (Join-Path $work 'old.yaml') -Destination $config -Force
                    if ($oldTask) {
                        Restore-DDNSTOTask $oldXml
                        if ($wasRunning) { Start-DDNSTOTask; Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe') }
                    } else { Remove-DDNSTOTask }
                } else {
                    Remove-DDNSTOTask
                    if (Get-DDNSTOTask) { throw 'DDNSTO: task removal failed' }
                    if (Test-Path -LiteralPath $binary) { Remove-Item -LiteralPath $binary -Force }
                }
                Copy-Item -LiteralPath (Join-Path $work 'old-marker') -Destination $marker -Force
            } catch {
                $keepBackup = $true
                try { [IO.File]::WriteAllText($marker, 'ddnsto-windows-v1:recovery-required') } catch { }
                Write-Warning 'DDNSTO：回滚失败；状态：恢复资料已保留；下一步：检查安装目录中的 .lifecycle-* 备份与计划任务，人工恢复；错误码：6'
            }
        }
        throw "DDNSTO: $Action failed; check local state before retrying"
    } finally {
        try {
            if (-not $keepBackup -and (Test-Path -LiteralPath $work)) { Remove-Item -LiteralPath $work -Recurse -Force }
        } finally {
            $lock.Dispose()
            Remove-Item -LiteralPath $lockPath -Force
        }
    }
    if ($Action -eq 'uninstall') { return 'operation=uninstall installation=retained local_service=not-installed configuration=retained identity=retained cloud_status=unverified' }
    $message = if ($Action -eq 'reinstall') { '重新安装并启动成功' } else { '配置更新并启动成功' }
    return "DDNSTO：$message；operation=$Action installation=installed local_service=running cloud_status=unverified"
}

function Assert-DDNSTOManagedTask($InstallDir, [switch]$AllowMissingTask) {
    if ((Get-DDNSTOManagedState $InstallDir) -ne 'installed') { throw 'DDNSTO: installed service required' }
    $binary = Join-Path $InstallDir 'ddnsto_cli.x86_64.exe'
    $config = Join-Path $InstallDir 'ddnsto.yaml'
    foreach ($path in @($InstallDir, $binary, $config, (Join-Path $InstallDir '.installer-windows-v1'))) {
        if (-not (Test-Path -LiteralPath $path)) { throw 'DDNSTO: complete managed installation required' }
        if ((Get-Item -LiteralPath $path -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) {
            throw 'DDNSTO: reparse points are not supported'
        }
        if ($path -ne $InstallDir -and -not (Test-Path -LiteralPath $path -PathType Leaf)) {
            throw 'DDNSTO: installation files must be regular files'
        }
    }
    $task = Get-DDNSTOTask
    if (-not $task -and $AllowMissingTask) { return $null }
    $environment = Get-DDNSTORecordedEnvironment $config
    $expected = if ($environment) { Get-DDNSTOEnvironmentAction $binary $config $InstallDir $environment } else {
        [pscustomobject]@{ Execute=$binary; Arguments=('--config "' + $config + '"'); WorkingDirectory=$InstallDir }
    }
    if (-not (Test-DDNSTOTaskAction $task $expected)) {
        throw 'DDNSTO: task does not match this managed installation'
    }
    return $task
}

function Invoke-DDNSTORepair {
    param([string]$InstallDir)
    Assert-DDNSTOPlatform
    if (-not [IO.Path]::IsPathRooted($InstallDir)) { throw 'DDNSTO: installation path must be absolute' }
    $null = Assert-DDNSTOManagedTask $InstallDir -AllowMissingTask
    $lockPath = Join-Path $InstallDir '.install-lock'
    $lock = [IO.File]::Open($lockPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
    $work = Join-Path $InstallDir ('.repair-' + [guid]::NewGuid().ToString('N'))
    $changed = $false
    $keepBackup = $false
    $oldTask = $null
    $oldXml = ''
    $wasRunning = $false
    try {
        # Recheck ownership under the same lock used by install/update/manage.
        $oldTask = Assert-DDNSTOManagedTask $InstallDir -AllowMissingTask
        $wasRunning = $oldTask -and $oldTask.State -eq 'Running'
        New-Item -ItemType Directory -Path $work | Out-Null
        if ($oldTask) {
            $oldXml = Export-DDNSTOTask
            if ([string]::IsNullOrWhiteSpace($oldXml)) { throw 'DDNSTO: could not export previous task' }
            [IO.File]::WriteAllText((Join-Path $work 'old-task.xml'), $oldXml)
        }
        $changed = $true
        if ($oldTask) { Stop-DDNSTOTask }
        Register-DDNSTOTask (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe') (Join-Path $InstallDir 'ddnsto.yaml') $InstallDir
        $null = Assert-DDNSTOManagedTask $InstallDir
        Start-DDNSTOTask
        Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
        $changed = $false
    } catch {
        if ($changed) {
            try {
                if (Get-DDNSTOTask) { Stop-DDNSTOTask }
                if ($oldTask) {
                    Restore-DDNSTOTask $oldXml
                    if ($wasRunning) { Start-DDNSTOTask; Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe') }
                } else {
                    Remove-DDNSTOTask
                    if (Get-DDNSTOTask) { throw 'DDNSTO: newly created task could not be removed' }
                }
            } catch {
                $keepBackup = $true
                Write-Warning 'DDNSTO：修复回滚失败；状态：恢复资料已保留；下一步：检查安装目录中的 .repair-* 备份与计划任务，人工恢复；错误码：6'
            }
        }
        throw 'DDNSTO: repair failed; client configuration was not rewritten; check task state before retrying'
    } finally {
        try {
            if (-not $keepBackup -and (Test-Path -LiteralPath $work)) { Remove-Item -LiteralPath $work -Recurse -Force }
        } finally {
            $lock.Dispose()
            Remove-Item -LiteralPath $lockPath -Force
        }
    }
    return 'DDNSTO：修复并启动成功；operation=repair local_service=running cloud_status=unverified'
}

function Invoke-DDNSTOManageService {
    param([string]$InstallDir, [string]$Action)
    Assert-DDNSTOPlatform
    if (-not [IO.Path]::IsPathRooted($InstallDir)) { throw 'DDNSTO: installation path must be absolute' }
    if ($Action -eq 'status') {
        $state = Get-DDNSTOManagedState $InstallDir
        if ($state -eq 'retained') { return 'installation=retained local_service=not-installed configuration=retained identity=retained cloud_status=unverified' }
        if ($state -eq 'recovery-required') { return 'installation=recovery-required local_service=unknown cloud_status=unverified' }
    }
    $task = Assert-DDNSTOManagedTask $InstallDir
    if ($Action -ne 'status') {
        $lockPath = Join-Path $InstallDir '.install-lock'
        # Acquire outside try/finally: never remove a lock held by another caller.
        $lock = [IO.File]::Open($lockPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
        try {
            $null = Assert-DDNSTOManagedTask $InstallDir
            if ($Action -eq 'stop') {
                Disable-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName | Out-Null
                Stop-DDNSTOTask
            } else {
                Enable-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName | Out-Null
                if ($Action -eq 'restart') { Stop-DDNSTOTask }
                Start-DDNSTOTask
                Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
            }
            $task = Assert-DDNSTOManagedTask $InstallDir
        } finally {
            $lock.Dispose()
            Remove-Item -LiteralPath $lockPath -Force
        }
    }
    $state = switch ([string]$task.State) {
        'Running' { 'running' }
        'Ready' { 'stopped' }
        'Disabled' { 'stopped' }
        'Queued' { 'starting' }
        default { throw 'DDNSTO: unknown scheduled task state' }
    }
    if ($Action -eq 'stop' -and $state -ne 'stopped') { throw 'DDNSTO: task did not stop' }
    if ($Action -eq 'status' -and $state -eq 'running') {
        Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
    }
    if ($Action -in @('start', 'restart')) { return "DDNSTO：启动成功；local_service=$state cloud_status=unverified" }
    return "local_service=$state cloud_status=unverified"
}

function Assert-DDNSTOPlatform {
    if ([Environment]::OSVersion.Platform -ne [PlatformID]::Win32NT) { throw 'DDNSTO: Windows is required' }
    $arch = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }
    if ($arch -ne 'AMD64') { throw 'DDNSTO: this candidate requires Windows x64' }
    $principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
        # Do not relaunch user-writable scripts as SYSTEM/admin or weaken execution policy.
        Stop-DDNSTOError 2 '需要管理员权限，无法安全自动提权' '未修改安装' '右键以管理员身份打开 PowerShell，按现有执行策略重新运行原命令'
    }
    foreach ($name in @('Get-ScheduledTask', 'Register-ScheduledTask', 'Export-ScheduledTask', 'icacls.exe')) {
        Get-Command $name -ErrorAction Stop | Out-Null
    }
}
function Protect-DDNSTODirectory($Path) {
    # SID-based ACLs work on non-English Windows installations.
    & icacls.exe $Path /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'DDNSTO: could not protect installation directory' }
}
function Get-DDNSTOZsetup($Work) {
    try { return Get-ZsetupBootstrap }
    catch { throw 'DDNSTO: latest stable zsetup bootstrap failed; old installation unchanged' }
}
function Receive-DDNSTOCandidate($Work, $Version) {
    Write-DDNSTODiagnosticEvent 'download'
    $zsetup = Get-DDNSTOZsetup $Work
    $archive = Join-Path $Work 'client.zip'
    & $zsetup download -o $archive --sha256 @@windows.archive_sha256@@ "https://fw.koolcenter.com/binary/ddnsto/windows/ddnsto_windows_cli_$Version.zip" | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'DDNSTO: zsetup download or checksum verification failed' }
    $extract = Join-Path $Work 'extract'
    Expand-Archive -LiteralPath $archive -DestinationPath $extract
    $candidate = Join-Path $extract 'ddnsto_cli.x86_64.exe'
    if ((Get-FileHash -LiteralPath $candidate -Algorithm SHA256).Hash -ine '@@windows.binary_sha256@@') {
        throw 'DDNSTO: client checksum mismatch'
    }
    return $candidate
}
function Get-DDNSTOTask { return Get-ScheduledTask -TaskPath '\' -ErrorAction Stop | Where-Object { $_.TaskName -eq $script:DDNSTOTaskName } }
function Export-DDNSTOTask { return Export-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName }
function Stop-DDNSTOTask {
    $task = Get-DDNSTOTask
    if (-not $task -or @($task.Actions).Count -ne 1) { throw 'DDNSTO: cannot identify task to stop' }
    $directory = $task.Actions[0].WorkingDirectory
    Assert-DDNSTOSafePaths $directory
    $binary = Join-Path $directory 'ddnsto_cli.x86_64.exe'
    $config = Join-Path $directory 'ddnsto.yaml'
    # During rollback the saved task can still use the old environment while
    # YAML already has the new record. Accept only the three exact owned action
    # shapes, not an arbitrary command, independently of that changing record.
    $legacy = [pscustomobject]@{Execute=$binary; Arguments=('--config "'+$config+'"'); WorkingDirectory=$directory}
    $owned = Test-DDNSTOTaskAction $task $legacy
    foreach ($knownEnvironment in @('production','test')) {
        if (Test-DDNSTOTaskAction $task (Get-DDNSTOEnvironmentAction $binary $config $directory $knownEnvironment)) { $owned=$true }
    }
    if (-not $owned) { throw 'DDNSTO: task ownership changed before stop' }
    Stop-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName
    for ($i = 0; $i -lt 20; $i++) {
        # The task is now a PowerShell parent. A stopped task is NOT evidence
        # that its client child exited. Never replace files or launch a second
        # environment while an exact-path owned process may still be alive.
        $clients = @(Get-CimInstance -ClassName Win32_Process -Filter "Name = 'ddnsto_cli.x86_64.exe'" -Property ProcessId,ExecutablePath -ErrorAction Stop |
            Where-Object { -not $_.ExecutablePath -or [string]::Equals($_.ExecutablePath, $binary, [StringComparison]::OrdinalIgnoreCase) })
        if ((Get-DDNSTOTask).State -ne 'Running' -and $clients.Count -eq 0) { return }
        Start-Sleep -Milliseconds 250
    }
    throw 'DDNSTO: old task/client did not stop; files retained; inspect the exact managed client process before retrying'
}
function Remove-DDNSTOTask {
    if (Get-DDNSTOTask) { Unregister-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName -Confirm:$false }
}
function Register-DDNSTOTask($Binary, $Config, $Directory) {
    $environment = Get-DDNSTORecordedEnvironment $Config
    if ($environment) {
        $expected = Get-DDNSTOEnvironmentAction $Binary $Config $Directory $environment
        $action = New-ScheduledTaskAction -Execute $expected.Execute -Argument $expected.Arguments -WorkingDirectory $Directory
    } else {
        $action = New-ScheduledTaskAction -Execute $Binary -Argument ('--config "' + $Config + '"') -WorkingDirectory $Directory
    }
    $principal = New-ScheduledTaskPrincipal -UserId 'S-1-5-18' -LogonType ServiceAccount -RunLevel Highest
    $settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit ([TimeSpan]::Zero) -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 1) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
    Register-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName -Action $action -Principal $principal -Trigger (New-ScheduledTaskTrigger -AtStartup) -Settings $settings -Force | Out-Null
}
function Restore-DDNSTOTask($Xml) { Register-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName -Xml $Xml -Force | Out-Null }
function Start-DDNSTOTask { Start-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName }
function Confirm-DDNSTORunning($Binary) {
    Write-DDNSTODiagnosticEvent 'stability'
    # Caller supplies the managed executable path, never a path inferred from a
    # potentially unrelated process. Do not collect command lines or client logs.
    $previous = $null
    try {
        if (-not [IO.Path]::IsPathRooted($Binary)) { throw 'missing trusted path' }
        for ($i = 0; $i -lt 4; $i++) {
            Start-Sleep -Seconds 1
            $task = Get-DDNSTOTask
            $directory = [IO.Path]::GetDirectoryName($Binary)
            $config = Join-Path $directory 'ddnsto.yaml'
            $environment = Get-DDNSTORecordedEnvironment $config
            $expected = if ($environment) { Get-DDNSTOEnvironmentAction $Binary $config $directory $environment } else {
                [pscustomobject]@{ Execute=$Binary; Arguments=('--config "' + $config + '"'); WorkingDirectory=$directory }
            }
            if ($task.State -ne 'Running' -or -not (Test-DDNSTOTaskAction $task $expected)) { throw 'task mismatch' }
            $processes = @(Get-CimInstance -ClassName Win32_Process -Filter "Name = 'ddnsto_cli.x86_64.exe'" -Property ProcessId,CreationDate,ExecutablePath -ErrorAction Stop |
                Where-Object { [string]::Equals($_.ExecutablePath, $Binary, [StringComparison]::OrdinalIgnoreCase) })
            if ($processes.Count -ne 1 -or -not $processes[0].CreationDate -or $processes[0].ProcessId -le 0) { throw 'unknown process' }
            $current = '{0}:{1}' -f $processes[0].ProcessId, ([datetime]$processes[0].CreationDate).ToUniversalTime().Ticks
            if ($null -ne $previous -and $current -cne $previous) { throw 'process restarted' }
            $previous = $current
        }
    } catch {
        Stop-DDNSTOError 5 '本地进程稳定性检查失败' '未确认稳定运行' '检查计划任务与客户端权限，排查进程退出或重启后重试'
    }
}
function Assert-DDNSTOSameToken($Config, $Token) {
    # Deliberately accept only a flat scalar mapping. YAML aliases, quoted keys,
    # documents and multiline values need manual review, never a guessed owner.
    $seen = @{}
    $stored = $null
    foreach ($line in [IO.File]::ReadAllLines($Config)) {
        if ($line -match '^\s*(#.*)?$') { continue }
        if ($line -cnotmatch "^([A-Za-z][A-Za-z0-9_]*):[ ]+(.*)$") {
            Stop-DDNSTOError 3 '无法确认配置归属' '原安装保留' '人工检查配置格式与账号'
        }
        $key = $Matches[1]; $value = $Matches[2]
        if ($seen.ContainsKey($key) -or $value -notmatch "^(?:'(?:[^'\r\n]|'')*'|[A-Za-z0-9_./\\:-]+)[ ]*(?:#.*)?$") {
            Stop-DDNSTOError 3 '配置存在重复字段或不支持的 YAML' '原安装保留' '人工检查配置格式与账号'
        }
        $seen[$key] = $true
        if ($key -ceq 'userToken' -and $value -cmatch "^'((?:[^'\r\n]|'')*)'[ ]*(?:#.*)?$") {
            $stored = $Matches[1].Replace("''", "'")
        }
    }
    if ([string]::IsNullOrWhiteSpace($stored) -or -not [string]::Equals($stored, $Token, [StringComparison]::Ordinal)) {
        Stop-DDNSTOError 3 'Token 不同或账号归属未知' '原安装保留' '核对原账号 Token；换号请明确使用 -Action configure'
    }
}

function Get-DDNSTOClientVersion($Path) {
    Write-DDNSTODiagnosticEvent 'version'
    # -v exits before normal client startup/config loading. Bound the local probe.
    $info = New-Object Diagnostics.ProcessStartInfo
    $info.FileName = $Path; $info.Arguments = '-v'
    $info.UseShellExecute = $false; $info.CreateNoWindow = $true
    $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true
    $process = New-Object Diagnostics.Process
    $process.StartInfo = $info
    try {
        $null = $process.Start()
        # Fixed-size concurrent pipe reads: cap each stream at 4 KiB, including
        # stderr (discarded). The deadline also covers EOF from inherited pipes.
        $streams = @($process.StandardOutput.BaseStream, $process.StandardError.BaseStream)
        $buffers = @((New-Object byte[] 512), (New-Object byte[] 512))
        $reads = @($streams[0].ReadAsync($buffers[0], 0, 512), $streams[1].ReadAsync($buffers[1], 0, 512))
        $counts = @(0, 0); $ended = @($false, $false)
        $output = New-Object IO.MemoryStream
        $clock = [Diagnostics.Stopwatch]::StartNew()
        try {
            while (-not ($ended[0] -and $ended[1] -and $process.HasExited)) {
                if ($clock.ElapsedMilliseconds -ge 5000) { throw 'version timeout' }
                for ($streamIndex = 0; $streamIndex -lt 2; $streamIndex++) {
                    if ($ended[$streamIndex] -or -not $reads[$streamIndex].IsCompleted) { continue }
                    $count = $reads[$streamIndex].GetAwaiter().GetResult()
                    if ($count -eq 0) { $ended[$streamIndex] = $true; continue }
                    $counts[$streamIndex] += $count
                    if ($counts[$streamIndex] -gt 4096) { throw 'version output limit' }
                    if ($streamIndex -eq 0) { $output.Write($buffers[0], 0, $count) }
                    $reads[$streamIndex] = $streams[$streamIndex].ReadAsync($buffers[$streamIndex], 0, 512)
                }
                Start-Sleep -Milliseconds 10
            }
            $text = [Text.Encoding]::UTF8.GetString($output.ToArray()).Trim()
        } finally { $output.Dispose() }
        if ($process.ExitCode -ne 0 -or $text -cnotmatch '^\d+\.\d+\.\d+$') { throw 'unknown version' }
        return $text
    } catch {
        Stop-DDNSTOError 4 '无法确认已安装版本' '原安装保留，禁止降级' '检查客户端版本后重试'
    } finally {
        try { if (-not $process.HasExited) { $process.Kill() } } catch { }
        $process.Dispose()
    }
}
function Invoke-DDNSTOInstall {
    param([string]$Token = '', [string]$TokenFile = '', [string]$Version = '@@windows.client_version@@', [string]$InstallDir, [string]$Action = 'ensure',
          [ValidateSet('production', 'test')][string]$Environment = 'production', [switch]$SwitchEnvironment)
    if ($Action -notin @('ensure', 'install', 'update')) { throw 'DDNSTO: unknown action' }
    if ($SwitchEnvironment -and $Action -eq 'install') { Stop-DDNSTOError 2 'E_ENV_SWITCH_ACTION：显式 install 不切换环境' '未修改安装' '使用 ensure/update 与 -SwitchEnvironment' }
    if ($Action -eq 'update' -and ($Token -or $TokenFile)) { throw 'DDNSTO: update preserves existing Token; do not supply credentials' }
    Assert-DDNSTOPlatform
    if ($Version -ne '@@windows.client_version@@') { throw 'DDNSTO: no pinned artifact for requested version' }
    if (-not [IO.Path]::IsPathRooted($InstallDir)) { throw 'DDNSTO: installation path must be absolute' }
    Assert-DDNSTOSafePaths $InstallDir
    $currentEnvironment = Assert-DDNSTOBusinessEnvironment $InstallDir $Environment -SwitchEnvironment:$SwitchEnvironment
    $changingEnvironment = $currentEnvironment -cne $Environment
    if ($TokenFile) {
        if ($Token) { Stop-DDNSTOError 2 'Token 与 TokenFile 不能同时传入' '未修改安装' '仅保留一个凭据参数' }
        try { $Token = [IO.File]::ReadAllText($TokenFile) -replace '\r?\n$', '' }
        catch { Stop-DDNSTOError 2 '无法读取 Token 文件' '未修改安装' '检查文件权限与路径' }
    }
    if (($Action -in @('ensure', 'install') -and [string]::IsNullOrWhiteSpace($Token)) -or $Token -match '[\x00-\x1f\x7f]') {
        Stop-DDNSTOError 2 '需要非空单行 Token' '未修改安装' '通过 -Token 或 -TokenFile 传入凭据'
    }
    if (Test-Path -LiteralPath (Join-Path $InstallDir '.installer-windows-v1')) {
        if ((Get-DDNSTOManagedState $InstallDir) -eq 'retained') {
            if ($changingEnvironment) { Stop-DDNSTOError 2 'E_ENV_SWITCH_ACTION：保留配置须先在原环境重新安装' '未修改安装' '恢复原环境后再使用 ensure -SwitchEnvironment' }
            if ($Action -notin @('ensure', 'install')) { throw 'DDNSTO: retained configuration requires ensure or install' }
            Assert-DDNSTOSameToken (Join-Path $InstallDir 'ddnsto.yaml') $Token
            return Invoke-DDNSTOLifecycle -InstallDir $InstallDir -Action reinstall -Token $Token -Version $Version
        }
        $null = Assert-DDNSTOManagedTask $InstallDir
    }
    $binary = Join-Path $InstallDir 'ddnsto_cli.x86_64.exe'
    $config = Join-Path $InstallDir 'ddnsto.yaml'
    $marker = Join-Path $InstallDir '.installer-windows-v1'
    foreach ($path in @($InstallDir, $binary, $config, $marker)) {
        if ((Test-Path -LiteralPath $path) -and ((Get-Item -LiteralPath $path -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'DDNSTO: reparse points are not supported' }
    }
    $oldTask = Get-DDNSTOTask
    $hadOld = Test-Path -LiteralPath $marker -PathType Leaf
    if ($hadOld) {
        if (-not $oldTask -or -not (Test-Path -LiteralPath $binary) -or -not (Test-Path -LiteralPath $config)) { throw 'DDNSTO: incomplete previous installation' }
    } elseif ($oldTask -or (Test-Path -LiteralPath $binary) -or (Test-Path -LiteralPath $config)) {
        throw 'DDNSTO: existing unmanaged installation; migrate it before retrying'
    }
    if (-not $hadOld -and (Test-Path -LiteralPath $InstallDir) -and
        @(Get-ChildItem -LiteralPath $InstallDir -Force).Count -gt 0) {
        throw 'DDNSTO: nonempty unmanaged directory; migrate it before retrying'
    }
    if ($Action -eq 'update' -and -not $hadOld) { throw 'DDNSTO: no existing installation; install first' }
    if ($hadOld -and $Action -eq 'install') {
        Stop-DDNSTOError 3 '已有安装，显式 install 不覆盖' '原安装保留' '省略 -Action 并传入原账号 Token 自动处理，或使用 -Action update'
    }
    $tokenLine = "userToken: '" + $Token.Replace("'", "''") + "'"
    if ($hadOld) {
        if ($Action -eq 'ensure') { Assert-DDNSTOSameToken $config $Token }
    } elseif ([string]::IsNullOrWhiteSpace($Token)) { throw 'DDNSTO: token is required on first installation' }
    New-Item -ItemType Directory -Path $InstallDir -Force | Out-Null
    $lockPath = Join-Path $InstallDir '.install-lock'
    $lock = [IO.File]::Open($lockPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
    $work = Join-Path $InstallDir ('.transaction-' + [guid]::NewGuid().ToString('N'))
    $changed = $false
    $keepBackup = $false
    $oldXml = ''
    $wasRunning = $hadOld -and $oldTask.State -eq 'Running'
    try {
        Assert-DDNSTOSafePaths $InstallDir
        Protect-DDNSTODirectory $InstallDir
        $currentTask = Get-DDNSTOTask
        if ($hadOld -ne (Test-Path -LiteralPath $marker -PathType Leaf) -or
            [bool]$oldTask -ne [bool]$currentTask) { throw 'DDNSTO: installation changed; retry' }
        if ($hadOld) {
            $null = Assert-DDNSTOManagedTask $InstallDir
            $lockedEnvironment = Assert-DDNSTOBusinessEnvironment $InstallDir $Environment -SwitchEnvironment:$SwitchEnvironment
            if ($lockedEnvironment -cne $currentEnvironment) { throw 'DDNSTO: business environment changed; retry' }
            if (-not (Test-Path -LiteralPath $binary -PathType Leaf) -or -not (Test-Path -LiteralPath $config -PathType Leaf)) { throw 'DDNSTO: incomplete previous installation' }
            if ($Action -eq 'ensure') { Assert-DDNSTOSameToken $config $Token }
            $installedVersion = Get-DDNSTOClientVersion $binary
            if ($installedVersion -notmatch '^\d+\.\d+\.\d+$') {
                Stop-DDNSTOError 4 '无法确认已安装版本' '原安装保留，禁止降级' '检查客户端版本后重试'
            }
            if ([version]$installedVersion -ge [version]$Version -and -not $changingEnvironment) {
                Assert-DDNSTOEnvironmentCapability $binary $Environment
                $alreadyRunning = $currentTask.State -eq 'Running'
                # A running instance may coexist with a disabled startup task.
                Enable-ScheduledTask -TaskPath '\' -TaskName $script:DDNSTOTaskName | Out-Null
                if (-not $alreadyRunning) {
                    Start-DDNSTOTask
                }
                Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
                $message = if ($alreadyRunning) { '已稳定运行' } else { '启动成功' }
                return "DDNSTO：$message；版本 $installedVersion；local_service=running cloud_status=unverified"
            }
        } elseif ((Test-Path -LiteralPath $binary) -or (Test-Path -LiteralPath $config)) { throw 'DDNSTO: installation changed; retry' }
        $wasRunning = $hadOld -and $currentTask.State -eq 'Running'
        New-Item -ItemType Directory -Path $work | Out-Null
        # A same/newer client can change environment without a downgrade/download.
        $candidate = if ($hadOld -and [version]$installedVersion -ge [version]$Version) { $binary } else { Receive-DDNSTOCandidate $work $Version }
        Assert-DDNSTOEnvironmentCapability $candidate $Environment -SwitchEnvironment:$changingEnvironment
        if ($hadOld) {
            Copy-Item -LiteralPath $binary -Destination (Join-Path $work 'old.exe')
            Copy-Item -LiteralPath $config -Destination (Join-Path $work 'old.yaml')
            $oldXml = Export-DDNSTOTask
            [IO.File]::WriteAllText((Join-Path $work 'old-task.xml'), $oldXml)
            if (Test-Path -LiteralPath (Join-Path $InstallDir '.ddnsto_boot.cfg')) {
                Copy-Item -LiteralPath (Join-Path $InstallDir '.ddnsto_boot.cfg') -Destination (Join-Path $work 'old-identity')
            }
        }
        $changed = $true
        if ($hadOld) { Stop-DDNSTOTask }
        if ($candidate -ne $binary) { Copy-Item -LiteralPath $candidate -Destination $binary -Force }
        if (-not $hadOld) {
            $logPath = (Join-Path $InstallDir 'logs').Replace("'", "''")
            [IO.File]::WriteAllText($config, $tokenLine + "`nlogPath: '" + $logPath + "'`n", (New-Object Text.UTF8Encoding($false)))
        }
        Set-DDNSTOBusinessEnvironment $config $Environment
        Register-DDNSTOTask $binary $config $InstallDir
        Start-DDNSTOTask
        Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe')
        [IO.File]::WriteAllText($marker, 'ddnsto-windows-v1')
        $changed = $false
        $message = if ($hadOld) { '升级并启动成功' } else { '安装成功，已启动' }
        Write-Output "DDNSTO：$message；版本 $Version；local_service=running cloud_status=unverified"
    } catch {
        if ($changed) {
            try {
                if (Get-DDNSTOTask) { Stop-DDNSTOTask }
                if ($hadOld) {
                    Copy-Item -LiteralPath (Join-Path $work 'old.exe') -Destination $binary -Force
                    Copy-Item -LiteralPath (Join-Path $work 'old.yaml') -Destination $config -Force
                    if ($changingEnvironment) {
                        $identity = Join-Path $InstallDir '.ddnsto_boot.cfg'
                        if (Test-Path -LiteralPath (Join-Path $work 'old-identity')) {
                            Copy-Item -LiteralPath (Join-Path $work 'old-identity') -Destination $identity -Force
                        } elseif (Test-Path -LiteralPath $identity) { Remove-Item -LiteralPath $identity -Force }
                    }
                    Restore-DDNSTOTask $oldXml
                    if ($wasRunning) { Start-DDNSTOTask; Confirm-DDNSTORunning (Join-Path $InstallDir 'ddnsto_cli.x86_64.exe') }
                } else {
                    Remove-DDNSTOTask
                    foreach ($file in @($binary, $config, $marker)) {
                        if (Test-Path -LiteralPath $file) { Remove-Item -LiteralPath $file -Force }
                    }
                }
            } catch {
                $keepBackup = $true
                try { [IO.File]::WriteAllText($marker, 'ddnsto-windows-v1:recovery-required') } catch { }
                Write-Warning 'DDNSTO：回滚失败；状态：恢复资料已保留；下一步：检查安装目录中的 .transaction-* 备份与计划任务，人工恢复；错误码：6'
            }
        }
        if ($_.Exception.Data.Contains('DDNSTOCode')) { throw }
        Stop-DDNSTOError 5 '安装或本地启动检查失败' '未确认稳定运行' '检查下载、权限及计划任务；使用 -Action status 查看状态'
    } finally {
        $lock.Dispose()
        Remove-Item -LiteralPath $lockPath -Force
        if (-not $keepBackup -and (Test-Path -LiteralPath $work)) { Remove-Item -LiteralPath $work -Recurse -Force }
    }
}
if ($MyInvocation.InvocationName -ne '.') {
    try {
        Invoke-DDNSTOEntry -Token $Token -TokenFile $TokenFile -Version $Version -InstallDir $InstallDir -Platform $Platform -Method $Method -Plan:$Plan -Action $Action -Environment $Environment -SwitchEnvironment:$SwitchEnvironment
        exit 0
    } catch {
        [Console]::Error.WriteLine($_.Exception.Message)
        $code = [int]$_.Exception.Data['DDNSTOCode']
        if ($code -le 0) { $code = 1 }
        exit $code
    }
}
